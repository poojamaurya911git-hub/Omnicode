# FILE: .env.example
# OmniCode Backend — Environment Variables

# ============================================
# MongoDB (Primary Database)
# ============================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/omnicode?retryWrites=true&w=majority

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=your-secret-key-min-32-chars-change-this-in-production

# ============================================
# Redis (Session Cache, Yjs State, Rate Limiting)
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# JDoodle API (Code Execution)
# ============================================
JDOODLE_CLIENT_ID=your-jdoodle-client-id
JDOODLE_CLIENT_SECRET=your-jdoodle-client-secret

# ============================================
# Google Gemini API (AI Coach + Analyzer)
# ============================================
GEMINI_API_KEY=your-gemini-api-key

# ============================================
# Pinecone (RAG Vector Store)
# ============================================
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_INDEX=omnicode-rag

# ============================================
# Service URLs
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3001
COLLAB_ENGINE_URL=http://localhost:4000
QUESTION_SERVICE_URL=http://localhost:8000
AI_SERVICE_URL=http://localhost:8001

# ============================================
# PostgreSQL (Question/Problem Cache)
# ============================================
POSTGRES_URL=postgresql://user:pass@localhost:5432/omnicode
